generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String               @id @default(cuid())
  email       String               @unique
  password    String
  isPaid      Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  purchases   Purchase[]
  resetTokens PasswordResetToken[]
}

model Lead {
  id          String     @id @default(cuid())
  email       String
  quizAnswers String
  source      String
  ipAddress   String?
  userAgent   String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  fbclid      String?
  fbc         String?
  fbp         String?
  pageUrl     String?
  createdAt   DateTime   @default(now())
  purchases   Purchase[]
}

model Video {
  id              String   @id @default(cuid())
  title           String
  description     String?
  gcsPath         String
  durationSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Purchase {
  id              String   @id @default(cuid())
  userId          String?
  leadId          String?
  email           String
  stripeSessionId String   @unique
  status          String
  planId          String
  amount          Int
  currency        String
  source          String?
  purchaseEventId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lead            Lead?    @relation(fields: [leadId], references: [id])
  user            User?    @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
